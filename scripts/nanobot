#!/bin/bash
SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
# 自动检测 JAVA_HOME：环境变量 > macOS > Windows 默认路径
if [ -z "$JAVA_HOME" ]; then
    if [ -x "/usr/libexec/java_home" ]; then
        JAVA_HOME="$(/usr/libexec/java_home -v 17 2>/dev/null || /usr/libexec/java_home)"
    else
        JAVA_HOME="D:/devSoftWare/jdk17/jdk-17.0.19+10"
    fi
fi
export JAVA_HOME
export PATH="$JAVA_HOME/bin:$PATH"

JAR="$SCRIPT_DIR/target/nanobot-cli.jar"

# 源码有更新？自动重新打包
if [[ ! -f "$JAR" ]] || [[ -n "$(find "$SCRIPT_DIR/src/main/java" -name '*.java' -newer "$JAR" 2>/dev/null | head -1)" ]]; then
    echo "(source changed, rebuilding...)"
    (cd "$SCRIPT_DIR" && mvn package -Dmaven.test.skip=true -q)
fi

ORIG_DIR="$PWD"
cd "$SCRIPT_DIR" && java -Dloader.main=com.nanobot.v3.NanobotCliApplication -jar "$JAR" --workspace "$ORIG_DIR" "$@"
